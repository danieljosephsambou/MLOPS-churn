# === Copier ce fichier en `.env` et adapter si besoin ===

# --- Base de données applicative (logs de prédictions) ---
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=mlops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MLflow ---
# URI vu depuis les conteneurs (réseau docker-compose)
MLFLOW_TRACKING_URI=http://mlflow:5000
# Nom de l'expérience et du modèle enregistré
MLFLOW_EXPERIMENT_NAME=churn
MODEL_NAME=churn-classifier
# Alias du registry à servir ("production"). Tant qu'aucun modèle n'est promu,
# l'API sert automatiquement la dernière version. Vide => toujours la dernière.
MODEL_ALIAS=production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Repli local si MLflow est indisponible ---
LOCAL_MODEL_PATH=models/model.joblib
